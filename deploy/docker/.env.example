# -----------------------------------------------------------------------
# Companion — Docker Compose environment template
# Copy this file to .env and fill in your real values.
# Never commit the .env file to version control.
# -----------------------------------------------------------------------

# ------------------------------------------------------------------
# Tailscale
# ------------------------------------------------------------------
# One-time auth key from https://login.tailscale.com/admin/settings/keys
# Reusable ephemeral keys are recommended for servers:
#   tailscale keys generate --ephemeral --reusable --tags=tag:companion
# Keys expire — see docs/deploy/README.md for rotation instructions.
TS_AUTHKEY=tskey-auth-<YOUR_KEY_HERE>

# ------------------------------------------------------------------
# Companion / LLM providers
# ------------------------------------------------------------------
# Bearer token used by Claude Code CLI to authenticate with Companion.
# Set this to any strong random string, e.g.:
#   openssl rand -hex 32
ANTHROPIC_AUTH_TOKEN=your-secret-token-here

# Primary LLM provider API keys — set only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------
# Memory / RAG
# ------------------------------------------------------------------
# Colon-separated list of directories to index for memory search.
# Mount these paths into the companion container if they live outside /data.
MEMORY_INDEX_PATHS=/data/notes

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
# Companion binds 0.0.0.0 inside the container; Tailscale controls
# which external addresses are reachable.
FCC_HOST=0.0.0.0
FCC_PORT=8082
